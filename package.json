{
  "name": "ts-hajime",
  "version": "0.5.7",
  "description": "Bootstrap a TypeScript npm library in one command.",
  "type": "module",
  "scripts": {
    "setup": "rm -rf node_modules && npm i && husky",
    "prepublishOnly": "npm i && npm run build",
    "build": "tsdown",
    "test": "vitest",
    "lint": "oxlint",
    "format": "oxfmt",
    "npx": "tsx src",
    "update": "npx npm-check-updates -u && npm i"
  },
  "devDependencies": {
    "@clack/prompts": "^1.6.0",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^26.1.0",
    "@types/validate-npm-package-name": "^4.0.2",
    "@vitest/coverage-v8": "^4.1.9",
    "execa": "^9.6.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "oxfmt": "^0.57.0",
    "oxlint": "^1.72.0",
    "tsdown": "^0.22.3",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "validate-npm-package-name": "^8.0.0",
    "vitest": "^4.1.9"
  },
  "lint-staged": {
    "*": [
      "npm run lint",
      "npm run format"
    ]
  },
  "bin": {
    "ts-hajime": "./bin/index.cjs"
  },
  "files": [
    "./bin",
    "./template",
    "./template/.gitignore"
  ],
  "keywords": [
    "bootstrap",
    "library",
    "scaffold",
    "starter",
    "template",
    "typescript"
  ],
  "bugs": {
    "url": "https://github.com/tylim88/ts-hajime/issues"
  },
  "license": "MIT",
  "author": "tylim",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tylim88/ts-hajime.git"
  }
}
