{
  "name": "my-package",
  "description": "my-description",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "setup": "rm -rf node_modules && npm i && git init && husky",
    "prepublishOnly": "npm run build",
    "build": "tsdown && tsdown --config tsdown.npx.ts",
    "test": "vitest",
    "npx": "tsx npx",
    "lint": "oxlint",
    "format": "oxfmt ."
  },
  "devDependencies": {
    "@clack/prompts": "^1.2.0",
    "@types/node": "^26.1.0",
    "@vitest/coverage-v8": "^4.1.9",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "oxfmt": "^0.57.0",
    "oxlint": "^1.72.0",
    "tsdown": "^0.22.3",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "bin": {
    "my-package": "./bin/index.cjs"
  },
  "files": ["bin", "dist"],
  "lint-staged": {
    "*": ["npm run lint"]
  },
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/???/???.git"
  },
  "bugs": {
    "url": "https://github.com/???/???/issues"
  },
  "author": "???",
  "license": "???"
}
