{
  "name": "my-package",
  "description": "my-description",
  "version": "0.0.0",
  "scripts": {
    "setup": "rm -rf node_modules && npm i && git init && husky",
    "prepublishOnly": "npm run build",
    "build": "tsdown",
    "test": "vitest",
    "lint": "oxlint --fix",
    "format": "oxfmt --write"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "@vitest/coverage-v8": "^4.1.9",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "oxfmt": "^0.57.0",
    "oxlint": "^1.72.0",
    "tsdown": "^0.22.3",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "lint-staged": {
    "*": [
      "npm run lint"
    ]
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    }
  },
  "keywords": [],
  "bugs": {
    "url": "https://github.com/???/???/issues"
  },
  "license": "???",
  "author": "???",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/???/???.git"
  }
}
